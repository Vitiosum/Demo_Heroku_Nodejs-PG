<header class="cc-topbar">
  <div class="cc-container cc-topbar__inner">
    <a href="https://www.clever.cloud" target="_blank" rel="noopener" aria-label="Clever Cloud">
      <%- include("cc-logo.ejs") %>
    </a>
    <span class="cc-topbar__sep"></span>
    <div class="cc-topbar__demo"><small>Demo</small>Heroku to Clever Cloud</div>
    <span class="cc-topbar__spacer"></span>
    <nav class="cc-topbar__nav" aria-label="Pages">
      <a class="cc-topbar__link<%= current === '/' ? ' is-active' : '' %>" href="/"<%- current === '/' ? ' aria-current="page"' : '' %>>The move</a>
      <a class="cc-topbar__link<%= current === '/db-init' ? ' is-active' : '' %>" href="/db-init"<%- current === '/db-init' ? ' aria-current="page"' : '' %>>Build the box</a>
      <a class="cc-topbar__link<%= current === '/db' ? ' is-active' : '' %>" href="/db"<%- current === '/db' ? ' aria-current="page"' : '' %>>Unpack</a>
      <% if (cc.onClever) { %>
        <span class="cc-pill cc-pill--live cc-hide-sm"><span class="cc-dot"></span>Live on Clever Cloud</span>
      <% } else { %>
        <span class="cc-pill cc-pill--muted cc-hide-sm"><span class="cc-dot cc-dot--muted"></span>Local</span>
      <% } %>
      <a class="cc-pill cc-pill--gradient" href="https://academy.clever.cloud" target="_blank" rel="noopener">Get certified</a>
    </nav>
  </div>
</header>
